# Backend API Base URL configuration template
# Copy this file to .env and set your active backend API URL:

BACKEND_API_URL=https://your-backend-api-url.com
API_BASE_URL=https://your-backend-api-url.com

# Examples:
# BACKEND_API_URL=http://127.0.0.1:8000
# BACKEND_API_URL=http://10.0.2.2:8000
# BACKEND_API_URL=http://192.168.1.100:8000
